---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { copy, href, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
}
const { lang, title, description, image } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const path = Astro.url.pathname.replace(/^\/ar(?=\/|$)/, '') || '/';
const nav = [
  { label: t.about.title, href: href(lang, '/#about') },
  { label: t.work.title, href: href(lang, '/work'), current: path.startsWith('/work') },
  { label: t.nav.contact, href: href(lang, '/#contact') },
];
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={href('en', path)} />
    <link rel="alternate" hreflang="ar" href={href('ar', path)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..600&family=Vazirmatn:wght@300..700&display=swap"
    />
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="skip">{t.ui.skip}</a>
    <div class="backdrop" aria-hidden="true" transition:persist></div>
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <header class="flex flex-wrap items-center gap-x-8 gap-y-2 py-6 text-[0.9375rem]">
        <a href={href(lang, '/')} class="me-auto font-medium">{t.name}</a>
        <nav aria-label={t.ui.nav}>
          <ul class="flex gap-6">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={n.current ? 'page' : undefined}
                    class="relative text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
                  >
                    {n.label}
                    {n.current && <span class="nav-mark" aria-hidden="true" />}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href={href(other, path)} hreflang={other} lang={other} class="text-muted transition-colors hover:text-fg">{t.ui.switchTo}</a>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="flex flex-wrap items-center justify-between gap-4 fade-rule py-8 text-sm text-muted">
        <span>{t.status}</span>
        <span>© {new Date().getFullYear()} {t.name}</span>
      </footer>
    </div>
  </body>
</html>

<script>
  // Lazy images fade in once loaded instead of popping in mid-scroll.
  document.addEventListener('astro:page-load', () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const img of document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')) {
      if (img.complete) continue;
      img.addEventListener('load', () => img.animate({ opacity: [0, 1] }, { duration: 400, easing: 'ease-out' }), { once: true });
    }
  });

  // Contact links: once the scroll lands on the contact panel, its border glows once.
  // Armed by the click (from any page) and spent on the first scroll end that leaves the panel in view.
  let armedAt = 0;
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest?.('a[href$="#contact"]')) armedAt = Date.now();
  });
  addEventListener('scrollend', () => {
    const panel = document.querySelector<HTMLElement>('#contact .panel');
    if (!panel || Date.now() - armedAt > 3000 || panel.getBoundingClientRect().top > innerHeight) return;
    armedAt = 0;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    panel.animate({ borderColor: ['#ffffff1f', '#ffffff80', '#ffffff1f'] }, { duration: 1400, easing: 'ease-out' });
  });
</script>
