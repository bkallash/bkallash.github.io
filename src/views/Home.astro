---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { copy, href, type Lang } from '../data/i18n';
import { links, skills, type Slug } from '../data/shared';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const a = t.about;
const selected: Slug[] = ['invoice-ocr', 'zakat-chat'];
const contacts = [
  { label: t.contact.email, value: links.email, href: `mailto:${links.email}`, ltr: true },
  { label: t.contact.whatsapp, value: t.contact.whatsappValue, href: links.whatsapp },
  { label: t.contact.linkedin, value: 'in/bayankallash', href: links.linkedin, ltr: true },
  { label: t.contact.github, value: 'bkallash', href: links.github, ltr: true },
  { label: t.contact.upwork, value: t.contact.upworkValue, href: links.upwork },
  { label: t.ui.cv, value: t.ui.downloadCv, href: links.cv, download: true },
];
const row = 'on-scroll grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6';
---

<Base lang={lang} title={t.home.title} description={t.home.line}>
  <section class="pt-14 pb-20 sm:pt-24 sm:pb-24">
    <h1 data-reveal style="--i:1" class="text-gradient text-5xl font-medium sm:text-6xl ltr:tracking-tight">{t.name}</h1>
    <p data-reveal style="--i:2" class="mt-3 text-2xl text-muted sm:text-3xl">{t.role}</p>
    <p class="mt-8 max-w-[40ch] text-xl text-pretty">
      {t.home.line.split(' ').map((w, i) => <><span class="word" style={`--i:${i}`}>{w}</span>{' '}</>)}
    </p>
    <p data-reveal style="--i:9" class="mt-10 flex flex-wrap gap-3 text-base">
      <a href="#contact" class="rounded-md bg-linear-to-b from-white to-[#c9c9c9] px-5 py-2.5 font-medium text-bg transition hover:opacity-85 active:scale-[.98]">{t.nav.contact}</a>
      <a href={links.cv} download class="group rounded-md border border-line px-5 py-2.5 transition hover:border-white/40 active:scale-[.98]">
        {t.ui.downloadCv} <span class="inline-block transition-transform group-hover:translate-y-0.5" aria-hidden="true">↓</span>
      </a>
    </p>
  </section>

  <section id="about" class="scroll-mt-6 fade-rule py-16">
    <h2 class="heading">{a.title}</h2>
    <div class="on-scroll mt-5 max-w-[62ch] space-y-4 text-lg text-pretty">
      <p>{a.bio[0]}</p>
      <p class="text-muted">{a.bio[1]}</p>
    </div>

    <dl class="mt-10 divide-y divide-line border-t border-line">
      <div class={row}>
        <dt class="text-muted">{a.education}</dt>
        <dd>
          <p>{a.degree}</p>
          <p class="mt-1 text-muted">{a.courses}</p>
        </dd>
      </div>
      <div class={row}>
        <dt class="text-muted">{a.built}</dt>
        <dd><ul class="flex flex-wrap gap-x-5 gap-y-1">{skills.built.map((s) => <li>{s}</li>)}</ul></dd>
      </div>
      <div class={row}>
        <dt class="text-muted">{a.also}</dt>
        <dd><ul class="flex flex-wrap gap-x-5 gap-y-1 text-muted">{skills.also.map((s) => <li>{s}</li>)}</ul></dd>
      </div>
    </dl>
  </section>

  <section id="projects" class="scroll-mt-6 fade-rule py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="heading">{t.home.selected}</h2>
      <a href={href(lang, '/work')} class="text-muted transition-colors hover:text-fg">
        {t.home.allProjects} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="mt-8 grid gap-12 sm:grid-cols-2 sm:gap-8">
      {selected.map((slug) => <ProjectCard lang={lang} slug={slug} />)}
    </div>
  </section>

  <section id="contact" class="fade-rule py-16">
    <div class="panel on-scroll relative isolate overflow-hidden rounded-2xl border border-line px-6 py-10 sm:px-12 sm:py-14">
      <div class="halo" aria-hidden="true"></div>
      <h2 class="heading">{t.nav.contact}</h2>
      <p class="text-gradient mt-3 max-w-[24ch] text-3xl font-medium text-pretty sm:text-4xl ltr:tracking-tight">{t.contact.line}</p>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          contacts.map((c) => (
            <li>
              <a
                href={c.href}
                download={c.download}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                class="group flex items-center justify-between gap-4 rounded-xl border border-line bg-black/60 px-5 py-4 backdrop-blur-sm transition duration-200 hover:border-white/35 hover:bg-white/[.06] active:scale-[.98]"
              >
                <span class="min-w-0">
                  <span class="block text-sm text-muted">{c.label}</span>
                  <span class="block truncate" dir={c.ltr ? 'ltr' : undefined}>{c.value}</span>
                </span>
                <span
                  class:list={[
                    'grid size-9 shrink-0 place-items-center rounded-full border border-line text-muted transition duration-200 group-hover:border-white/40 group-hover:text-fg',
                    c.download ? 'group-hover:translate-y-0.5' : 'rtl:-scale-x-100 group-hover:-translate-y-0.5 ltr:group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5',
                  ]}
                  aria-hidden="true"
                >
                  {c.download ? '↓' : '↗'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Panel: a faint vertical wash, and a lit top edge that fades out toward both corners. */
  .panel { background: linear-gradient(180deg, #ffffff0a, #ffffff03 60%); }
  .panel::before {
    content: '';
    position: absolute;
    inset-inline: 15%;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #ffffffcc, transparent);
  }

  /*
    Halo: a circle of light centered on the panel's top edge. The panel clips its upper half,
    so it shows as a half circle. It fades in as the panel scrolls into view, then stays still.
  */
  .panel { view-timeline-name: --contact; }
  .halo {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: min(46rem, 130%);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle closest-side, #ffffff30, #ffffff12 40%, #ffffff05 70%, transparent);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .halo {
        animation-name: appear;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --contact;
        animation-range: entry 10% cover 45%;
      }
    }
  }
  /* Spotlight: the panel's border lights up around the cursor (position set by the script below). */
  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(18rem circle at var(--x, 50%) var(--y, 0), #ffffff73, transparent 70%);
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity .4s;
    pointer-events: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .panel:hover::after { opacity: 1; }
  }
  @keyframes appear {
    from { opacity: 0; }
  }
</style>

<script>
  document.addEventListener('pointermove', (e) => {
    const panel = (e.target as Element).closest?.<HTMLElement>('.panel');
    if (!panel) return;
    const r = panel.getBoundingClientRect();
    panel.style.setProperty('--x', `${e.clientX - r.left}px`);
    panel.style.setProperty('--y', `${e.clientY - r.top}px`);
  });
</script>
