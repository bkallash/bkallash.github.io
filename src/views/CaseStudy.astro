---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { copy, href, type Lang } from '../data/i18n';
import { featured, type Slug } from '../data/shared';

interface Props {
  lang: Lang;
  slug: Slug;
}
const { lang, slug } = Astro.props;
const t = copy[lang];
const p = t.projects[slug];
const i = featured.findIndex((f) => f.slug === slug);
const project = featured[i];
const next = featured[(i + 1) % featured.length];
// Optional per project: add `live` and/or `code` URLs to its entry in shared.ts.
const urls = project as { live?: string; code?: string };
const projectLinks = [[urls.live, t.work.live], [urls.code, t.work.code]].filter(([url]) => url);
---

<Base lang={lang} title={`${p.title} · ${t.name}`} description={p.problem} image={`/og/${slug}.png`}>
  <article class="pt-10 pb-16 sm:pt-16">
    <Breadcrumb
      lang={lang}
      items={[{ label: t.ui.home, href: href(lang, '/') }, { label: t.work.title, href: href(lang, '/work') }, { label: p.title }]}
    />

    <header class="mt-10">
      <p data-reveal class="flex flex-wrap items-center gap-3 text-sm text-muted">
        {'folio' in project && t.caseStudy.folio}
        {'inDev' in project && <span class="rounded border border-line px-2 py-0.5">{t.caseStudy.inDev}</span>}
      </p>
      <h1 data-reveal style="--i:1" class="text-gradient mt-3 text-4xl font-medium sm:text-5xl ltr:tracking-tight">{p.title}</h1>
      <p data-reveal style="--i:2" class="mt-6 max-w-[62ch] text-xl text-pretty">{p.problem}</p>
      <p data-reveal style="--i:3" class="mt-6 max-w-[62ch] border-s-2 border-fg/40 ps-4 text-lg text-muted text-pretty">“{p.rule}”</p>
      <div data-reveal style="--i:4" class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <ul aria-label={t.caseStudy.stack} class="flex flex-wrap gap-2">
          {project.stack.map((s) => <li class="rounded border border-line px-2 py-0.5 text-sm text-muted">{s}</li>)}
        </ul>
        {
          projectLinks.map(([url, label]) => (
            <a href={url} target="_blank" rel="noopener" class="font-medium transition-colors hover:text-muted">
              {label} <span class="inline-block text-muted rtl:-scale-x-100" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </header>

    <section class="mt-16" aria-labelledby="results">
      <h2 id="results" class="heading">{t.caseStudy.results}</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-3">
        {
          p.results.map((r) => (
            <div class="on-scroll flex flex-col rounded-lg border border-line bg-linear-to-b from-white/[.06] to-transparent p-5">
              <dt class="order-2 mt-2">{r.label}</dt>
              <dd class="text-gradient order-1 text-4xl font-medium tabular-nums">
                <span data-count aria-hidden="true">{r.value}</span><span class="sr-only">{r.value}</span>
              </dd>
              <dd class="order-3 mt-1 text-sm text-muted">{r.note}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-16" aria-labelledby="how">
      <h2 id="how" class="heading">{t.caseStudy.how}</h2>
      <p class="mt-2 flex items-center gap-2 text-sm text-muted" aria-hidden="true">
        <span class="size-[9px] rounded-full border border-fg"></span>{t.caseStudy.person}
      </p>
      <div class="relative mt-4">
        <span class="rail" aria-hidden="true"></span>
        <span class="rail rail-fill" aria-hidden="true"></span>
        <ol>
          {
            p.flow.map((s, n) => (
              <li class="on-scroll relative ps-5 pb-3 last:pb-0">
                <span
                  class:list={['absolute -start-[4px] top-2 size-[9px] rounded-full', s.person ? 'border border-fg bg-bg' : 'bg-fg']}
                  aria-hidden="true"
                />
                <p>
                  <span class="text-sm text-muted tabular-nums">{String(n + 1).padStart(2, '0')}</span>
                  <span class="ms-2 font-medium">{s.step}</span>
                  {s.person && <span class="sr-only"> ({t.caseStudy.person})</span>}
                </p>
                <p class="max-w-[62ch] text-sm text-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="screens">
      <h2 id="screens" class="heading">{t.caseStudy.screens}</h2>
      <div class="mt-6 grid gap-10 sm:grid-cols-2 sm:gap-6">
        {
          project.shots.map((shot, n) => (
            <figure class="on-scroll first:sm:col-span-2">
              <button type="button" data-zoom aria-label={t.caseStudy.zoom} class="block w-full cursor-zoom-in rounded-lg">
                <img src={`/img/${shot}.webp`} alt={p.captions[n]} width="1600" height="1000" loading="lazy" class="w-full rounded-lg border border-line" />
              </button>
              <figcaption class:list={['mt-3 text-muted', n > 0 && 'text-sm']}>{p.captions[n]}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <a href={href(lang, `/work/${next.slug}`)} class="group mt-16 flex items-baseline justify-between gap-4 fade-rule pt-8">
      <span class="text-muted">{t.caseStudy.next}</span>
      <span class="text-lg font-medium">
        {t.projects[next.slug].title}
        <span class="inline-block text-muted transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100" aria-hidden="true">→</span>
      </span>
    </a>
  </article>

  <dialog id="zoom" class="zoom">
    <form method="dialog">
      <button class="absolute end-4 top-4 rounded-full border border-line bg-bg/80 px-3 py-1 text-sm">{t.caseStudy.close}</button>
    </form>
    <img alt="" class="max-h-[92dvh] max-w-[96vw] rounded-lg" />
  </dialog>
</Base>

<style>
  .zoom { max-width: none; max-height: none; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; place-items: center; }
  .zoom[open] { display: grid; }
  .zoom::backdrop { background: rgb(0 0 0 / 0.85); backdrop-filter: blur(4px); }
  /* Fallback where view transitions are missing (the script morphs the thumbnail otherwise): open-only settle. */
  @supports not (view-transition-name: none) {
    @media (prefers-reduced-motion: no-preference) {
      .zoom[open] img { animation: settle 220ms cubic-bezier(.2, .7, .2, 1); }
      .zoom[open]::backdrop { animation: fade 220ms ease-out; }
    }
  }
  @keyframes settle { from { opacity: 0; scale: .96; } }
  @keyframes fade { from { opacity: 0; } }
  /* Timeline rail; the white fill grows as the steps scroll into view. */
  .rail { position: absolute; inset-block: 0.5rem; inset-inline-start: 0; width: 1px; background: var(--color-line); }
  .rail-fill { background: linear-gradient(var(--color-fg), #ffffff33); transform-origin: top; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rail-fill { animation-name: grow; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 20% cover 70%; }
    }
  }
  @keyframes grow { from { transform: scaleY(0); } }
</style>

<script>
  // Count result numbers up from zero when they scroll into view. "5.7h" -> 5.7 + "h", "8/8" -> 8 + "/8".
  const run = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver((entries) => {
      for (const { isIntersecting, target } of entries) {
        if (!isIntersecting) continue;
        io.unobserve(target);
        const el = target as HTMLElement;
        const [, num, rest] = el.dataset.final!.match(/^(\d+(?:\.\d+)?)(.*)$/s)!;
        const decimals = num.split('.')[1]?.length ?? 0;
        const start = performance.now();
        const tick = (now: number) => {
          const k = Math.min((now - start) / 1400, 1);
          const eased = 1 - Math.pow(2, -10 * k);
          el.textContent = (Number(num) * (k === 1 ? 1 : eased)).toFixed(decimals) + rest;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    for (const el of document.querySelectorAll<HTMLElement>('[data-count]')) {
      if (!/^\d/.test(el.textContent!.trim())) continue;
      el.dataset.final = el.textContent!.trim();
      el.textContent = el.dataset.final.replace(/^[\d.]+/, (n) => (0).toFixed(n.split('.')[1]?.length ?? 0));
      io.observe(el);
    }
  };
  document.addEventListener('astro:page-load', run);

  // Lightbox: any [data-zoom] button opens its image full size; click anywhere or Esc closes.
  // Where view transitions exist, the thumbnail grows into the full image and shrinks back.
  let thumb: HTMLImageElement;
  const morph = (from: HTMLElement, to: HTMLElement, update: () => Promise<void> | void) => {
    if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return void update();
    from.style.viewTransitionName = 'zoom';
    const t = document.startViewTransition(async () => {
      from.style.viewTransitionName = '';
      to.style.viewTransitionName = 'zoom';
      await update();
    });
    t.finished.finally(() => (to.style.viewTransitionName = ''));
  };
  const close = (dialog: HTMLDialogElement) => morph(dialog.querySelector('img')!, thumb, () => dialog.close());

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const dialog = document.querySelector<HTMLDialogElement>('#zoom');
    if (!dialog) return;
    if (target.closest('#zoom')) {
      // Stop the Close button's form from closing the dialog before the morph captures it.
      e.preventDefault();
      return close(dialog);
    }
    const img = target.closest('[data-zoom]')?.querySelector('img');
    if (!img) return;
    thumb = img;
    const big = dialog.querySelector('img')!;
    Object.assign(big, { src: img.currentSrc, alt: img.alt });
    morph(img, big, async () => {
      await big.decode().catch(() => {});
      dialog.showModal();
    });
  });
  // Esc: run the same closing morph instead of the native instant close. `cancel` doesn't bubble, hence capture.
  document.addEventListener(
    'cancel',
    (e) => {
      if ((e.target as Element).id !== 'zoom') return;
      e.preventDefault();
      close(e.target as HTMLDialogElement);
    },
    true,
  );
</script>
